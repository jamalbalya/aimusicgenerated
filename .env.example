# Neural music generation (optional).
#
# Resonant Studio works with neither of these set — it falls back to nothing,
# because there is nothing to fall back to: the offline engine is always there
# and the neural engine simply shows as Not Connected until a backend answers.
#
# Point this at a running ACE-Step 1.5 API server. The default matches the
# address ACE-Step's own run_api_server.sh binds.
VITE_ACE_STEP_API_URL=http://127.0.0.1:8001

# Only needed when the backend was started with ACESTEP_API_KEY set.
# VITE_ACE_STEP_API_KEY=

# The smoke test (scripts/test-ace-step-bos-toxic.mjs) reads these instead,
# because it runs in Node rather than in the browser bundle.
# ACE_STEP_API_URL=http://127.0.0.1:8001
# ACE_STEP_API_KEY=
# ACE_STEP_MODEL=acestep-v15-turbo
# ACE_STEP_LM_MODEL=acestep-5Hz-lm-0.6B
