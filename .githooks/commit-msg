#!/usr/bin/env bash
# Refuses a commit message that credits anyone but the repository owner.
#
# This repository's commits are jamalbalya's. No assistant, bot or tool is
# named as an author, a co-author or a generator — not in a trailer, and not in
# the prose. See docs/GIT_IDENTITY_POLICY.md.
#
# Installed by `git config --local core.hooksPath .githooks`, so it is version
# controlled and applies to every clone that runs the same setup line.
set -euo pipefail

message_file="$1"
message="$(cat "$message_file")"

# Comment lines are stripped by git before the message is stored, so they are
# stripped here too — otherwise git's own commented template would trip this.
body="$(printf '%s\n' "$message" | sed '/^[[:space:]]*#/d')"

haystack="$body"

# Each entry is "pattern<TAB>explanation". Extended regex, case-insensitive.
violations=()
while IFS=$'\t' read -r pattern explanation; do
  [[ -z "$pattern" ]] && continue
  if printf '%s\n' "$haystack" | grep -qiE "$pattern"; then
    violations+=("$explanation")
  fi
done <<'RULES'
^[[:space:]]*co-authored-by:	a Co-authored-by trailer
^[[:space:]]*generated-by:	a Generated-by trailer
^[[:space:]]*(assisted|created|authored)-by:	an assistance trailer
generated with	a "generated with" credit
🤖	a robot emoji used as attribution
\bco-authored\b	a co-authorship claim
RULES

# Specific vendor or product names live in an untracked local list rather than
# in this file, so the repository itself never has to spell them out. One name
# or extended-regex pattern per line; blank lines and # comments ignored.
# Absent, the generic rules above still stand on their own.
blocklist="$(git rev-parse --git-dir)/attribution-blocklist"
if [[ -r "$blocklist" ]]; then
  while IFS= read -r pattern; do
    pattern="${pattern%%#*}"
    pattern="$(printf '%s' "$pattern" | tr -d '[:space:]')"
    [[ -z "$pattern" ]] && continue
    if printf '%s\n' "$haystack" | grep -qiE "$pattern"; then
      violations+=("a name from the local attribution blocklist")
    fi
  done < "$blocklist"
fi

if (( ${#violations[@]} > 0 )); then
  echo >&2
  echo "COMMIT REFUSED — this repository's commits carry no assistant attribution." >&2
  echo >&2
  echo "Found:" >&2
  printf '  - %s\n' "${violations[@]}" >&2
  echo >&2
  echo "Remove it and commit again. The policy is docs/GIT_IDENTITY_POLICY.md." >&2
  echo >&2
  exit 1
fi
